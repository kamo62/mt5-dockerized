# Local feature overrides for linux-mt5.
#
# Copy this file to `docker-compose.override.yml` (git-ignored) and uncomment
# the blocks for the features you want. Docker Compose merges it on top of
# docker-compose.yml automatically, so `docker compose up -d` picks it up.
#
# docker-compose.yml ships a minimal default: it only auto-installs MT5. Every
# optional feature is off; turn one on by uncommenting its block here.

services:
  linux-mt5:
    environment:
      # ===================================================================
      # Auto-install toggle (on by default in docker-compose.yml). Uncomment
      # to disable and install via the control UI's Install button instead.
      # ===================================================================
      # AUTO_INSTALL_MT5: "false"

      # ===================================================================
      # Official MetaTrader 5 installer (instead of the HFM default).
      # Keep the image on the tested WineHQ stable runtime (Wine 11).
      # ===================================================================
      # MT5_INSTALLER_URL: "https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe"
      # WINEDLLOVERRIDES: "mscoree=d;mshtml=d"

      # ===================================================================
      # Pre-config: apply MT5 common.ini [StartUp] and autoload an EA.
      # Put the compiled .ex5 in MQL5/Experts first. Choose ONE preset mode:
      #
      # A) Use an existing hand-authored .set file. Leave every MT5_EA_* line
      #    commented out; those variables generate and overwrite a preset.
      # ===================================================================
      # MT5_STARTUP_CONFIG: "true"
      # MT5_STARTUP_EXPERT: "TelegramTC_EA_v1.60"
      # MT5_STARTUP_SYMBOL: "XAUUSDb"
      # MT5_STARTUP_PERIOD: "M5"
      # MT5_STARTUP_PRESET: "telegramtc_ea_v1.60.set"
      #
      # B) Generate the .set from tenant credentials and EA inputs. Pass the
      #    tenant file with: docker compose --env-file tenant.env up -d
      #    The :? form fails fast instead of starting with missing credentials.
      # MT5_STARTUP_PRESET: "TelegramTC_EA_v1.60.generated.set"
      # MT5_EA_BackendBaseUrl: "${MT5_EA_BACKEND_BASE_URL:?set MT5_EA_BACKEND_BASE_URL}"
      # MT5_EA_LinkCode: "${MT5_EA_LINK_CODE:?set MT5_EA_LINK_CODE}"
      # MT5_EA_PollSeconds: "${MT5_EA_POLL_SECONDS:-1}"
      # MT5_EA_HeartbeatSeconds: "${MT5_EA_HEARTBEAT_SECONDS:-5}"
      # MT5_EA_MagicNumber: "${MT5_EA_MAGIC_NUMBER:?set MT5_EA_MAGIC_NUMBER}"
      # MT5_EA_SomeInput: "${MT5_EA_SOME_INPUT:-default}"
      #
      # MaxBars is pinned to 5000 when startup config is enabled.

      # ===================================================================
      # S3 sync of exported tick CSVs.
      # Step 1: set the flag.  Step 2: set S3_URI (+ creds if not on an EC2
      # instance role). The sync defers while a CSV is still being written.
      # ===================================================================
      # S3_SYNC_ENABLED: "true"
      # S3_URI: "s3://your-bucket/ticks"
      # S3_SYNC_SOURCE_DIR: "/data/exports"
      # S3_SYNC_INTERVAL_SECONDS: "60"
      # S3_SYNC_SETTLE_SECONDS: "60"
      #
      # On EC2 with an instance role, leave AWS_* commented (IMDS hop limit >= 2).
      # AWS_DEFAULT_REGION: "us-east-1"
      # AWS_ACCESS_KEY_ID: "..."
      # AWS_SECRET_ACCESS_KEY: "..."
      # AWS_SESSION_TOKEN: "..."
